{
  "name": "onsei-organizer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "build:web": "pnpm -C frontend/web build",
    "test:web": "pnpm -C frontend/web test",
    "typecheck:web": "pnpm -C frontend/web typecheck",
    "ci:quality": "pnpm install --frozen-lockfile && pnpm typecheck:web && pnpm test:web && pnpm build:web"
  }
}